<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>WindowsUpdateListView</Name>
      <ViewSelectedBy>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#root/InventoryLogging/MsftSil_WindowsUpdate</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <PropertyName>ID</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>InstallDate</PropertyName>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>ComputerListView</Name>
      <ViewSelectedBy>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#root/InventoryLogging/MsftSil_Computer</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <PropertyName>ChassisSerialNumber</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>CollectedDateTime</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Model</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Name</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>NumberOfCores</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>NumberOfLogicalProcessors</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>NumberOfProcessors</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>OSName</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>OSSku</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>OSSuite</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>OSSuiteMask</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>OSVersion</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>ProcessorFamily</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>ProcessorManufacturer</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>ProcessorName</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>SystemManufacturer</PropertyName>
              </ListItem>
           </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>ComputerIdentityListView</Name>
      <ViewSelectedBy>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#root/InventoryLogging/MsftSil_ComputerIdentity</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <PropertyName>ID</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>UUID</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>VMGUID</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Name</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>HypervisorHostName</PropertyName>
              </ListItem>
           </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>SoftwareListView</Name>
      <ViewSelectedBy>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#root/InventoryLogging/MsftSil_Software</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <PropertyName>ID</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Name</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>InstallDate</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Publisher</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Version</PropertyName>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>UalAccessListView</Name>
      <ViewSelectedBy>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#root/InventoryLogging/MsftSil_UalAccess</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <PropertyName>ProductName</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>RoleGuid</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>RoleName</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>SampleDate</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>UniqueDeviceAccessCount</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>UniqueUserAccessCount</PropertyName>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>ParameterListView</Name>
      <ViewSelectedBy>
        <TypeName>Microsoft.Management.Infrastructure.CimInstance#root/inventorylogging/__PARAMETERS</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <PropertyName>PSComputerName</PropertyName>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
  </ViewDefinitions>
</Configuration>
